# Copy to .env and fill in values for local development.
# Each app also reads this file (or its own .env) at startup via packages/shared/src/env.ts.
#
# Deliberately does NOT set NODE_ENV: `vite`/`vite build`, vitest, and every
# other tool here set it themselves per-command. An explicit value here
# overrides that, and on the previous Next.js build it was a confirmed,
# reproducible cause of `next build` crashing while prerendering `/404` —
# see docs/ARCHITECTURE.md's Status section. The specific crash is gone with
# Next, but the rule stands: let each tool set its own NODE_ENV.

# Postgres connection string used by packages/db and apps/api. Points at the
# local Supabase stack's Postgres (run `supabase start` first) —
# profiles.user_id has a real FK to auth.users, which only exists there. See
# docs/SCHEMA_DECISIONS.md.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project. These ANON/SERVICE_ROLE values are the well-known
# Supabase local-dev defaults (identical on every machine running `supabase
# start`), safe to commit — replace with real project values everywhere
# other than local dev.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Server-only — bypasses Row Level Security. Must never reach the client
# bundle or be sent to the browser. Only apps/api reads this.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# apps/api
API_PORT=4000

# apps/web
VITE_API_URL=http://localhost:4000
# Same Supabase project, exposed to the browser — the anon key is meant to
# be public; Row Level Security is what makes that safe.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# WhatsApp dispatch provider credentials (notifications module).
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
