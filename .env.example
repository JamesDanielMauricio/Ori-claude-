# Copy to .env and fill in values for local development.
# Each app also reads this file (or its own .env) at startup via packages/shared/src/env.ts.
#
# Deliberately does NOT set NODE_ENV: `vite`/`vite build`, vitest, and every
# other tool here set it themselves per-command. An explicit value here
# overrides that, and on the previous Next.js build it was a confirmed,
# reproducible cause of `next build` crashing while prerendering `/404` —
# see docs/ARCHITECTURE.md's Status section. The specific crash is gone with
# Next, but the rule stands: let each tool set its own NODE_ENV.

# Postgres connection string used by packages/db and apps/api. Points at the
# local Supabase stack's Postgres (run `supabase start` first) —
# profiles.user_id has a real FK to auth.users, which only exists there. See
# docs/SCHEMA_DECISIONS.md.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project. These ANON/SERVICE_ROLE values are the well-known
# Supabase local-dev defaults (identical on every machine running `supabase
# start`), safe to commit — replace with real project values everywhere
# other than local dev.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Server-only — bypasses Row Level Security. Must never reach the client
# bundle or be sent to the browser. Only apps/api reads this.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# apps/api
API_PORT=4000

# apps/web
VITE_API_URL=http://localhost:4000
# Same Supabase project, exposed to the browser — the anon key is meant to
# be public; Row Level Security is what makes that safe.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# WhatsApp dispatch (notifications module) — Green API credentials.
# Read in TWO places, which must hold the same values:
#   - supabase/functions/whatsapp-dispatch, a Supabase Edge Function (Deno),
#     where they are Edge Function secrets
#     (`supabase secrets set WHATSAPP_ENV=dev ... --project-ref <ref>`);
#   - apps/api, which sends the admin-mediated password reset's link itself
#     (packages/domain/src/auth/whatsapp-recovery-delivery.ts) — here, and in
#     the Vercel project's Environment Variables in production. apps/api reads
#     them only when a reset is sent, so the API still starts without them;
#     the reset screen then says WhatsApp isn't configured.
# See docs/ARCHITECTURE.md's notifications module section.
#
# Selects which credential pair below is used; anything other than exactly
# "live" (including unset) falls back to "dev" — the safe default, so a
# misconfigured env can never silently send real messages.
WHATSAPP_ENV=dev
# Green API instance id + token for the dev WhatsApp number (green-api.com).
WHATSAPP_DEV_ID_INSTANCE=
WHATSAPP_DEV_API_TOKEN=
#
# The dev-only send-redirect number (used whenever WHATSAPP_ENV=dev, so
# testing against real data can never reach an actual customer/grower) is
# NOT an env var — it's notification_settings.whatsapp_dev_override_phone,
# editable straight from the Supabase Table Editor with no redeploy. See
# migration 0045.
# Green API instance id + token for the real/live WhatsApp number. Leave
# unset until go-live cutover is deliberately decided.
WHATSAPP_LIVE_ID_INSTANCE=
WHATSAPP_LIVE_API_TOKEN=
