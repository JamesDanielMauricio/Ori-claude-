{
  "name": "@ori/db",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./supabase-types": "./src/supabase-types.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate-types": "supabase gen types typescript --local > src/supabase-types.ts",
    "migrate:from-bubble": "tsx scripts/migrate-from-bubble.ts",
    "bubble:export": "tsx scripts/bubble-export.ts",
    "import:from-bubble": "tsx scripts/import-from-bubble.ts"
  },
  "dependencies": {
    "@ori/shared": "workspace:*",
    "@supabase/supabase-js": "^2.47.0",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@ori/config": "workspace:*",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
